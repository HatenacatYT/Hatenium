{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Hatenium (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/Hatenium.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-debug",
            "environment": [
                { "name": "PATH", "value": "${config:hatenium.msys2Root}/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${config:hatenium.msys2Root}/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build Debug"
        }
    ]
}
